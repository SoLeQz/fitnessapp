# Copier ce fichier en `.env` puis remplir les valeurs.
#   cp .env.example .env

# Connexion PostgreSQL.
# En local, correspond au conteneur de docker-compose.yml (port 5433).
# En production, utiliser la chaîne fournie par l'hébergeur de base de données.
DATABASE_URL="postgresql://forgefit:forgefit@localhost:5433/forgefit"

# Clé de signature des sessions — 32 caractères minimum.
# Générer une valeur unique par environnement :
#   openssl rand -base64 48
AUTH_SECRET=""

# URL publique de l'application, utilisée dans les liens des emails.
APP_URL="http://localhost:3000"
